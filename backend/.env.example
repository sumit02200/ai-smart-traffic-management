# Comma-separated frontend origins. Use exact origins in production.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
# YOLO model name or path. First startup may download yolov8n.pt if not present.
YOLO_MODEL=yolov8n.pt
# Upload limit in MB
MAX_UPLOAD_MB=100
# Process one frame every N seconds (larger = faster, less granular)
FRAME_INTERVAL_SECONDS=0.5
# Optional output directory; temporary files are removed after response by default.
OUTPUT_DIR=./runtime
